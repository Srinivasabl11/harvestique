# Copy to .env (never commit .env):   copy .env.example .env
# Used by docker-compose AND by the backend when run natively on Windows.

# ---------- Application ----------
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_DB=harvestique
POSTGRES_USER=harvestique
POSTGRES_PASSWORD=harvestique
# Host port 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# Backend running natively (uvicorn on Windows) -> DB in Docker:
DATABASE_URL=postgresql+psycopg://harvestique:harvestique@localhost:5433/harvestique
# (docker-compose overrides DATABASE_URL for the backend container to use host "db".)

BACKEND_HOST_PORT=8000

# ---------- Auth ----------
# REQUIRED in production (>= 32 chars; the app refuses to start with the placeholder).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=harvestique
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Argon2id password hashing cost (argon2-cffi defaults; raise on stronger servers)
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_PARALLELISM=4
# Brute-force protection: N consecutive failed logins per phone locks it for the window
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- Providers ----------
# weather: open_meteo (free, no API key; the server needs internet) | fake (SIMULATED data, tests only)
# Production refuses every "fake" provider.
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# Mandi prices for the assistant's profit estimates: AGMARKNET daily prices from the Government of India Open Data
# API (data.gov.in, free). disabled (default): farmers are asked for a price | data_gov_in: needs your OWN free API
# key (register at https://data.gov.in, then "My Account" > API key). Never commit the key.
MARKET_PRICE_PROVIDER=disabled
DATA_GOV_IN_API_KEY=

# llm: disabled | ollama (local, free) | fake (tests only). With ollama the assistant also works when Ollama is
# stopped: it falls back to its keyword rules, and picks Ollama up again within 30 seconds of it starting.
#   Install https://ollama.com, then:  ollama pull llama3.2:3b   (or use a model you already have)
LLM_PROVIDER=ollama
# Native Ollama on Windows, backend native:     http://localhost:11434
# Native Ollama on Windows, backend in Docker:  http://host.docker.internal:11434 (docker-compose sets this)
OLLAMA_BASE_URL=http://localhost:11434
# Must be installed (`ollama list`). CPU-only PCs: a 3B model answers in a few seconds; 8B models are slower.
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
# What the local model may do in the assistant (answers about your data always come from the server's tools):
#   intents: choose a read-only tool when the keyword rules don't understand a question
#   general answers: short, labelled general farming answers (rejected if they contain numbers)
#   rewording: reword tool answers (slow on CPU-only machines)
ASSISTANT_LLM_INTENTS=true
ASSISTANT_LLM_GENERAL_ANSWERS=true
ASSISTANT_LLM_REWORDING=false
# Kannada general answers from small local models were garbled in testing; enable only with a model that
# writes good Kannada. Kannada questions about your own data are not affected.
ASSISTANT_LLM_GENERAL_ANSWERS_KANNADA=false

# Crop-health photo check: colour_heuristic (colour measurements only, no health label) | ollama_vision (a local
# vision model through the Ollama server above; free, no paid API). ollama_vision needs `ollama pull gemma3:4b`
# (about 3.3 GB download, about 6 GB RAM while running, roughly 10-75 s per photo on a CPU-only PC). When the model
# is missing or too slow, the colour check is used and the result says so.
CROP_HEALTH_CLASSIFIER=colour_heuristic
OLLAMA_VISION_MODEL=gemma3:4b
VISION_TIMEOUT_SECONDS=150
# true: report "unknown" instead of a problem when the only sign is generic spots at low confidence (fewer false
# alarms on healthy leaves, but some diseased leaves also become "unknown"; see docs/CROP_HEALTH_EVAL_2026-10-14.md)
CROP_HEALTH_GENERIC_SPOTS_UNCERTAIN=false
# v1 (evaluated production prompt) | v2 (candidate: tells the model veins, glare and dust are not damage and asks for
# the colour and extent of each sign; see docs/CROP_PHOTO_ANALYSIS_2026-10-15.md before switching)
CROP_HEALTH_PROMPT_VERSION=v1

# notifications: in_app | fake (tests only)
NOTIFICATION_CHANNEL=in_app

# ---------- Phone verification (one-time SMS codes) ----------
# Every registration and every login is finished with a code sent by SMS.
#   dev_console      DEVELOPMENT ONLY. No SMS is sent: the code is logged and shown in the app, labelled
#                    "DEVELOPMENT MODE - not sent by SMS". The server refuses to start with it when APP_ENV=production.
#   android_gateway  Your own Android phone sends the SMS with its SIM, using the open-source "SMS Gateway for
#                    Android" app (Apache-2.0, https://github.com/capcom6/android-sms-gateway) in Local Server mode.
#                    No SMS company account or API fee, but EACH CODE IS A NORMAL SMS ON THAT SIM: your mobile plan's
#                    SMS charges and daily SMS limits apply. The phone must stay on and reachable from the server.
#   disabled         Nobody can register or sign in.
# There is no genuinely free SMS service for production use; commercial providers charge per message.
SMS_PROVIDER=dev_console
# android_gateway only (shown in the gateway app's Local Server screen):
# SMS_GATEWAY_URL=http://192.168.1.50:8080
# SMS_GATEWAY_USERNAME=sms
# SMS_GATEWAY_PASSWORD=change-me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_CLIENT_PER_HOUR=20
