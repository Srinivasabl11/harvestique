<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen until Flutter draws its first frame: the brand seedling, centred. (Android 12+ first shows the
     system splash, which uses the adaptive launcher icon, i.e. the same seedling.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_seedling" />
    </item>
</layer-list>
